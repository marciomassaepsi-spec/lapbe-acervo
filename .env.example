# Copie este arquivo para .env.local e preencha. Na Vercel, cadastre as mesmas variáveis
# em Settings → Environment Variables.

# Supabase → Project Settings → API (ou Data API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# "Publishable key" (sb_publishable_...) ou a antiga "anon public key"
NEXT_PUBLIC_SUPABASE_KEY=

# Conta de serviço do Google (arquivo JSON baixado no Google Cloud)
GOOGLE_SERVICE_ACCOUNT_EMAIL=acervo-lapbe@SEU-PROJETO.iam.gserviceaccount.com
# Campo "private_key" do JSON, entre aspas, com os \n do jeito que estão
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ID da pasta da liga no Drive (o trecho depois de /folders/ no link da pasta)
DRIVE_FOLDER_ID=

# Modo demonstração: 1 = usa dados de exemplo, sem Supabase nem Drive
LAPBE_DEMO=0
